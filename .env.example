# AssemblyAI — required for Voice Agent API (needs a card on file, even for free credit)
ASSEMBLYAI_API_KEY=

# Optional: id of a stored Voice Agent (POST /v1/agents). BYO-LLM is only
# allowed on a stored agent, not on inline session.update (verified live
# 2026-09-07) — orchestrator/agent.py creates one automatically on first
# run if this is unset, and prints the id to save here so the next run
# reuses it instead of creating a duplicate.
ASSEMBLYAI_AGENT_ID=

# Only needed if bypassing the AssemblyAI Claude gateway (byo-llm to your own endpoint)
# Leave unset if using the gateway per CLAUDE.md constraint 6
ANTHROPIC_API_KEY=

# Supabase — inventory/menu, fleet state, escalations. Service role key
# (not anon/publishable) since orchestrator and task_engine are trusted
# backend processes writing past RLS. Get it from the dashboard: Project
# Settings -> API -> service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# No Twilio — the phone call is simulated via local mic/speaker, not a
# real SIP trunk. See PLAN.md Section 9 / ARCHITECTURE.md for why.
