# Copy to .env (repo root). Read server-side only: by the Python voice agent,
# the task engine, admin_api, and the Next.js route handlers in dashboard/.

# AssemblyAI Voice Agent API (needs a card on file, even for free credit)
ASSEMBLYAI_API_KEY=

# Optional: reuse one stored Voice Agent instead of creating one per call.
# Ignored when a call has a room (the room is baked into the agent's prompt).
ASSEMBLYAI_AGENT_ID=

# The LLM behind the voice agent (bring-your-own-LLM via OpenRouter)
OPENROUTER_API_KEY=

# Supabase: menu/stock, fleet state, deliveries, escalations, call log.
# The service-role key bypasses row-level security, so it stays server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set to 0 to skip the MuJoCo viewer window when admin_api starts a call
# CONCIERGE_VIEWER=1

# Optional (web demo): global cap on browser calls per day, default 100
# DEMO_DAILY_CALL_LIMIT=100

# ---------------------------------------------------------------------------
# dashboard/.env.local is a SEPARATE file. Anything prefixed NEXT_PUBLIC_ is
# compiled into the browser bundle, so use the ANON key there, never the
# service-role key:
#
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8000
#   NEXT_PUBLIC_DEMO_MODE=        # 1 on the hosted demo: admin writes read-only
# ---------------------------------------------------------------------------
